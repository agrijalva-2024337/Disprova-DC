NODE_ENV=development
PORT=3000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=disprova
# Debe coincidir con POSTGRES_PASSWORD en docker-compose.yml (dev: disprova_dev_password)
POSTGRES_PASSWORD=disprova_dev_password
POSTGRES_DB=disprova

# Prisma (desde el host use localhost; dentro de Docker use postgres)
DATABASE_URL=postgresql://disprova:disprova_dev_password@localhost:5432/disprova
