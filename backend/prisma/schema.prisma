generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Seguridad ---

model Role {
  id       Int    @id @default(autoincrement())
  nombre   String @unique
  permisos Json

  users User[]

  @@map("roles")
}

model User {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  roleId       Int      @map("role_id")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role        Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  auditLogs   AuditLog[]
  zones               Zone[]
  routeVisits         RouteVisit[]
  warehouses          Warehouse[]
  inventoryMovements  InventoryMovement[]
  orders              Order[]
  deliveries          Delivery[]
  cashSessions        CashSession[]
  cashExpenses        CashExpense[]
  payments            Payment[]
  collectionVisits    CollectionVisit[]
  returns             Return[]
  messageLogs          MessageLog[]
  clientAccessTokens   ClientAccessToken[]

  @@map("users")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  entidad      String
  entidadId    String   @map("entidad_id")
  accion       String
  datosAntes   Json?    @map("datos_antes")
  datosDespues Json?    @map("datos_despues")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entidad, entidadId])
  @@map("audit_log")
}

// --- Catálogo ---

model Category {
  id       Int     @id @default(autoincrement())
  nombre   String
  parentId Int?    @map("parent_id")
  orden    Int     @default(0)
  activo   Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([activo], map: "categories_activo_idx")
  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  nombre      String
  descripcion String?
  categoryId  Int      @map("category_id")
  marca       String?
  unidadBase  String   @map("unidad_base")
  controlado  Boolean  @default(false)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  category Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  units    ProductUnit[]
  images   ProductImage[]
  batches  ProductBatch[]
  stocks   Stock[]
  movements InventoryMovement[]

  @@index([activo], map: "products_activo_idx")
  @@map("products")
}

model ProductUnit {
  id           Int     @id @default(autoincrement())
  productId    Int     @map("product_id")
  nombre       String
  factor       Decimal @db.Decimal(12, 4)
  codigoBarras String? @unique @map("codigo_barras")
  precioBase   Decimal @map("precio_base") @db.Decimal(12, 2)
  activo       Boolean @default(true)

  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  priceListItems PriceListItem[]
  orderItems     OrderItem[]

  @@map("product_units")
}

model ProductImage {
  id          Int     @id @default(autoincrement())
  productId   Int     @map("product_id")
  url         String
  orden       Int     @default(0)
  esPrincipal Boolean @default(false) @map("es_principal")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("product_images")
}

model PriceList {
  id          Int     @id @default(autoincrement())
  nombre      String
  descripcion String?
  activo      Boolean @default(true)

  items   PriceListItem[]
  clients Client[]

  @@map("price_lists")
}

model PriceListItem {
  id            Int      @id @default(autoincrement())
  priceListId   Int      @map("price_list_id")
  productUnitId Int      @map("product_unit_id")
  precio        Decimal  @db.Decimal(12, 2)
  vigenteDesde  DateTime @map("vigente_desde") @db.Date
  /// false cuando el precio se deja de aplicar. El registro queda: un pedido
  /// viejo tiene que poder seguir mostrando de dónde salió su precio.
  activo        Boolean  @default(true)

  priceList   PriceList   @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Restrict)

  @@unique([priceListId, productUnitId, vigenteDesde])
  @@index([priceListId, productUnitId, activo, vigenteDesde(sort: Desc)], map: "price_list_items_lookup_idx")
  @@map("price_list_items")
}

// --- Comercial ---

enum TipoNegocio {
  tienda
  farmacia
  mercado
  otro

  @@map("tipo_negocio")
}

enum ResultadoVisita {
  pedido
  no_compro
  cerrado

  @@map("resultado_visita")
}

model Zone {
  id             Int     @id @default(autoincrement())
  nombre         String
  semanaMes      Int     @map("semana_mes")
  diasSemana     Int[]   @map("dias_semana")
  vendedorUserId Int?    @map("vendedor_user_id")
  activo         Boolean @default(true)

  vendedor User?    @relation(fields: [vendedorUserId], references: [id], onDelete: Restrict)
  clients  Client[]

  @@map("zones")
}

model Client {
  id              Int         @id @default(autoincrement())
  nombreComercial String      @map("nombre_comercial")
  nit             String?
  tipoNegocio     TipoNegocio @map("tipo_negocio")
  zoneId          Int         @map("zone_id")
  ordenRuta       Int         @map("orden_ruta")
  direccion       String
  lat             Decimal?    @db.Decimal(10, 7)
  lng             Decimal?    @db.Decimal(10, 7)
  priceListId     Int         @map("price_list_id")
  limiteCredito   Decimal     @default(0) @map("limite_credito") @db.Decimal(12, 2)
  plazoDias       Int         @default(0) @map("plazo_dias")
  activo          Boolean     @default(true)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  zone      Zone            @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  priceList PriceList       @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  contacts          ClientContact[]
  visits            RouteVisit[]
  orders            Order[]
  accountMovements  AccountMovement[]
  payments          Payment[]
  collectionVisits  CollectionVisit[]
  returns           Return[]
  messageLogs        MessageLog[]
  accessTokens       ClientAccessToken[]

  @@unique([zoneId, ordenRuta])
  @@index([activo, zoneId, ordenRuta], map: "clients_activo_zone_id_orden_ruta_idx")
  @@map("clients")
}

model ClientContact {
  id             Int     @id @default(autoincrement())
  clientId       Int     @map("client_id")
  nombre         String
  telefono       String
  esWhatsapp     Boolean @map("es_whatsapp")
  aceptaMensajes Boolean @default(false) @map("acepta_mensajes")
  esPrincipal    Boolean @default(false) @map("es_principal")

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@map("client_contacts")
}

model RouteVisit {
  id            Int             @id @default(autoincrement())
  clientId      Int             @map("client_id")
  userId        Int             @map("user_id")
  fecha         DateTime        @db.Date
  resultado     ResultadoVisita
  motivo        String?
  observaciones String?
  lat           Decimal?        @db.Decimal(10, 7)
  lng           Decimal?        @db.Decimal(10, 7)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("route_visits")
}

// --- Inventario ---

enum TipoAlmacen {
  bodega
  vehiculo

  @@map("tipo_almacen")
}

enum TipoMovimientoInventario {
  entrada
  salida
  traslado_salida
  traslado_entrada
  reserva
  liberacion_reserva
  ajuste
  merma

  @@map("tipo_movimiento_inventario")
}

model Warehouse {
  id                 Int         @id @default(autoincrement())
  nombre             String
  tipo               TipoAlmacen
  responsableUserId  Int?        @map("responsable_user_id")
  activo             Boolean     @default(true)

  responsable User?                @relation(fields: [responsableUserId], references: [id], onDelete: Restrict)
  stocks      Stock[]
  movements   InventoryMovement[]

  @@map("warehouses")
}

model ProductBatch {
  id                Int       @id @default(autoincrement())
  productId         Int       @map("product_id")
  lote              String
  fechaVencimiento  DateTime? @map("fecha_vencimiento") @db.Date
  costo             Decimal?  @db.Decimal(12, 2)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  product        Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  stocks         Stock[]
  movements      InventoryMovement[]
  deliveryItems  DeliveryItem[]
  returnItems    ReturnItem[]
  orderItems     OrderItemBatch[]

  @@unique([productId, lote])
  @@map("product_batches")
}

model Stock {
  id                 Int     @id @default(autoincrement())
  productId          Int     @map("product_id")
  warehouseId        Int     @map("warehouse_id")
  batchId            Int?    @map("batch_id")
  cantidad           Decimal @db.Decimal(12, 4)
  cantidadReservada  Decimal @default(0) @map("cantidad_reservada") @db.Decimal(12, 4)

  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batch     ProductBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId, batchId])
  @@map("stock")
}

model InventoryMovement {
  id              Int                       @id @default(autoincrement())
  productId       Int                       @map("product_id")
  warehouseId     Int                       @map("warehouse_id")
  batchId         Int?                      @map("batch_id")
  tipo            TipoMovimientoInventario
  cantidad        Decimal                   @db.Decimal(12, 4)
  referenciaTipo  String?                   @map("referencia_tipo")
  referenciaId    String?                   @map("referencia_id")
  userId          Int                       @map("user_id")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batch     ProductBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt], map: "inventory_movements_product_id_created_at_idx")
  @@index([referenciaTipo, referenciaId], map: "inventory_movements_referencia_idx")
  @@map("inventory_movements")
}

// --- Ventas ---

enum CanalPedido {
  campo
  web
  whatsapp

  @@map("canal_pedido")
}

enum EstadoPedido {
  borrador
  pendiente
  confirmado
  preparado
  en_ruta
  entregado
  entregado_parcial
  cancelado

  @@map("estado_pedido")
}

enum CondicionPago {
  contado
  credito

  @@map("condicion_pago")
}

enum EstadoEntrega {
  pendiente
  completa
  parcial

  @@map("estado_entrega")
}

model Order {
  id                   Int            @id @default(autoincrement())
  /// Correlativo de la secuencia PostgreSQL order_numero_seq. No depende del id.
  numero               String         @unique @default(dbgenerated("('PED-' || lpad(nextval('order_numero_seq')::text, 6, '0'))"))
  clientId             Int            @map("client_id")
  userId               Int            @map("user_id")
  canal                CanalPedido
  estado               EstadoPedido
  condicionPago        CondicionPago  @map("condicion_pago")
  subtotal             Decimal        @db.Decimal(12, 2)
  descuento            Decimal        @default(0) @db.Decimal(12, 2)
  impuesto             Decimal        @db.Decimal(12, 2)
  total                Decimal        @db.Decimal(12, 2)
  fechaEntregaPrevista DateTime?      @map("fecha_entrega_prevista") @db.Date
  /// NULL cuando el alta no trae clave. Varios NULL conviven: el índice único no los trata como iguales.
  idempotencyKey       String?        @map("idempotency_key")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  deliveries           Delivery[]
  paymentApplications  PaymentApplication[]
  returns              Return[]
  invoice              Invoice?

  @@index([clientId, createdAt], map: "orders_client_id_created_at_idx")
  @@index([userId, createdAt], map: "orders_user_id_created_at_idx")
  @@unique([clientId, userId, idempotencyKey], map: "orders_client_user_idempotency_key")
  @@map("orders")
}

model OrderItem {
  id             Int     @id @default(autoincrement())
  orderId        Int     @map("order_id")
  productUnitId  Int     @map("product_unit_id")
  cantidad       Decimal @db.Decimal(12, 4)
  /// Copiado al crear el pedido. No se recalcula después desde price_list_items.
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  /// Copiado al crear el pedido. No se recalcula después desde price_list_items.
  descuento      Decimal @default(0) @db.Decimal(12, 2)
  /// Copiado al crear el pedido. No se recalcula después desde price_list_items.
  impuesto       Decimal @db.Decimal(12, 2)
  totalLinea     Decimal @map("total_linea") @db.Decimal(12, 2)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productUnit    ProductUnit    @relation(fields: [productUnitId], references: [id], onDelete: Restrict)
  deliveryItems  DeliveryItem[]
  returnItems    ReturnItem[]
  batches        OrderItemBatch[]

  @@index([orderId])
  @@map("order_items")
}

/// Qué lote quedó reservado para esta línea, y de cuánto.
///
/// El FEFO de `confirmOrder` calculaba el lote correcto pero lo descartaba:
/// la entrega lo tomaba del cuerpo de la petición del vendedor. Eso rompía
/// la trazabilidad de medicamentos y hacía que `liberacion_reserva` pudiera
/// consumir la reserva de otro pedido sobre ese lote. Con esta tabla la
/// entrega consume lo que el pedido reservó, y `vigente` deja el rastro de
/// qué reservas ya se descargaron sin borrar la historia.
model OrderItemBatch {
  id          Int     @id @default(autoincrement())
  orderItemId Int     @map("order_item_id")
  batchId     Int     @map("batch_id")
  /// Cantidad en unidad base del producto, no en presentación.
  cantidad    Decimal @db.Decimal(12, 4)
  /// false cuando esa parte de la reserva ya se entregó o se liberó.
  vigente     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  orderItem OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  batch     ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, batchId])
  @@index([orderItemId])
  @@map("order_item_batches")
}

model Delivery {
  id            Int            @id @default(autoincrement())
  orderId       Int            @map("order_id")
  userId        Int            @map("user_id")
  fecha         DateTime       @db.Date
  estado        EstadoEntrega
  recibidoPor   String?        @map("recibido_por")
  firmaUrl      String?        @map("firma_url")
  observaciones String?

  order Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user  User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  items DeliveryItem[]

  @@map("deliveries")
}

model DeliveryItem {
  id                 Int     @id @default(autoincrement())
  deliveryId         Int     @map("delivery_id")
  orderItemId        Int     @map("order_item_id")
  cantidadEntregada  Decimal @map("cantidad_entregada") @db.Decimal(12, 4)
  batchId            Int?    @map("batch_id")

  delivery  Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  batch     ProductBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@map("delivery_items")
}

enum MetodoPago {
  efectivo
  transferencia
  cheque

  @@map("metodo_pago")
}

enum EstadoCaja {
  abierta
  cerrada

  @@map("estado_caja")
}

enum ResultadoCobranza {
  pago_completo
  pago_parcial
  compromiso
  sin_contacto

  @@map("resultado_cobranza")
}

enum TipoMovimientoCuenta {
  cargo
  abono

  @@map("tipo_movimiento_cuenta")
}

model AccountMovement {
  id              Int                   @id @default(autoincrement())
  clientId        Int                   @map("client_id")
  tipo            TipoMovimientoCuenta
  referenciaTipo  String                @map("referencia_tipo")
  referenciaId    String                @map("referencia_id")
  monto           Decimal               @db.Decimal(12, 2)
  /// Saldo del cliente justo después de este movimiento. Se guarda al crearlo y no se recalcula.
  saldoResultante Decimal               @map("saldo_resultante") @db.Decimal(12, 2)
  fecha           DateTime              @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId, fecha], map: "account_movements_client_id_fecha_idx")
  @@index([referenciaTipo, referenciaId], map: "account_movements_referencia_idx")
  @@map("account_movements")
}

model CashSession {
  id            Int         @id @default(autoincrement())
  userId        Int         @map("user_id")
  fecha         DateTime    @db.Date
  fondoInicial  Decimal     @map("fondo_inicial") @db.Decimal(12, 2)
  totalCobrado  Decimal     @default(0) @map("total_cobrado") @db.Decimal(12, 2)
  totalGastos   Decimal     @default(0) @map("total_gastos") @db.Decimal(12, 2)
  conteoFinal   Decimal?    @map("conteo_final") @db.Decimal(12, 2)
  diferencia    Decimal?    @db.Decimal(12, 2)
  estado        EstadoCaja  @default(abierta)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  cerradaAt     DateTime?   @map("cerrada_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments  Payment[]
  expenses  CashExpense[]

  @@map("cash_sessions")
}

/// Gasto de la jornada de ruta.
///
/// `cash_sessions.total_gastos` existía como columna y se usaba en el arqueo,
/// pero NADA la escribía: no había forma de registrar un gasto. Cualquier gasto
/// real (combustible, viáticos, comida) descuadraba el arqueo sin que el sistema
/// pudiera explicarlo. El monto se descuenta del esperado al cerrar la caja.
model CashExpense {
  id             Int      @id @default(autoincrement())
  cashSessionId  Int      @map("cash_session_id")
  userId         Int      @map("user_id")
  fecha          DateTime @default(now()) @db.Timestamptz(3)
  concepto       String
  monto          Decimal  @db.Decimal(12, 2)
  /// Foto o PDF del recibo. El archivo vive fuera del contenedor: aquí solo la URL.
  reciboUrl      String?  @map("recibo_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([cashSessionId])
  @@map("cash_expenses")
}

model Payment {
  id             Int        @id @default(autoincrement())
  clientId       Int        @map("client_id")
  userId         Int        @map("user_id")
  fecha          DateTime   @db.Timestamptz(3)
  monto          Decimal    @db.Decimal(12, 2)
  metodo         MetodoPago
  referencia     String?
  cashSessionId  Int?       @map("cash_session_id")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  client       Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  cashSession  CashSession?         @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  applications PaymentApplication[]

  @@index([fecha])
  @@map("payments")
}

model PaymentApplication {
  id             Int     @id @default(autoincrement())
  paymentId      Int     @map("payment_id")
  orderId        Int     @map("order_id")
  montoAplicado  Decimal @map("monto_aplicado") @db.Decimal(12, 2)

  payment  Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  /// El cobro se aplica al pedido. No hay tabla de facturas en este módulo.
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("payment_applications")
}

model CollectionVisit {
  id                 Int               @id @default(autoincrement())
  clientId           Int               @map("client_id")
  userId             Int               @map("user_id")
  fecha              DateTime          @db.Timestamptz(3)
  resultado          ResultadoCobranza
  montoComprometido  Decimal?          @map("monto_comprometido") @db.Decimal(12, 2)
  fechaCompromiso    DateTime?         @map("fecha_compromiso") @db.Date
  observaciones      String?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("collection_visits")
}

enum EstadoDevolucion {
  pendiente
  aceptada
  rechazada

  @@map("estado_devolucion")
}

enum DestinoDevolucion {
  reingreso
  merma

  @@map("destino_devolucion")
}

model Return {
  id         Int              @id @default(autoincrement())
  clientId   Int              @map("client_id")
  orderId    Int              @map("order_id")
  userId     Int              @map("user_id")
  fecha      DateTime         @db.Timestamptz(3)
  motivo     String
  estado     EstadoDevolucion @default(pendiente)
  /// Se calcula al aceptar, con el precio y el impuesto congelados en la línea. Mientras está pendiente queda en 0.
  total      Decimal          @default(0) @db.Decimal(12, 2)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  order  Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user   User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  items  ReturnItem[]

  @@map("returns")
}

model ReturnItem {
  id           Int               @id @default(autoincrement())
  returnId     Int               @map("return_id")
  orderItemId  Int               @map("order_item_id")
  cantidad     Decimal           @db.Decimal(12, 4)
  batchId      Int?              @map("batch_id")
  destino      DestinoDevolucion

  returnOrder Return        @relation(fields: [returnId], references: [id], onDelete: Restrict)
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  batch       ProductBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@map("return_items")
}

// --- Mensajería ---

enum CanalMensaje {
  wa_link
  whatsapp_api

  @@map("canal_mensaje")
}

enum EstadoMensaje {
  generado
  enviado
  fallido

  @@map("estado_mensaje")
}

model MessageTemplate {
  id     Int           @id @default(autoincrement())
  nombre String        @unique
  canal  CanalMensaje
  /// Texto con variables tipo {nombre}, {saldo}, {ultimoPedidoUrl}
  cuerpo String
  activo Boolean       @default(true)
  createdAt DateTime   @default(now()) @map("created_at")

  logs MessageLog[]

  @@map("message_templates")
}

model MessageLog {
  id         Int           @id @default(autoincrement())
  clientId   Int           @map("client_id")
  templateId Int?          @map("template_id")
  telefono   String
  /// Texto ya resuelto con las variables
  contenido  String
  canal      CanalMensaje
  estado     EstadoMensaje @default(generado)
  error      String?
  userId     Int           @map("user_id")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  template MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@map("message_logs")
}

// --- Catálogo web público por token ---

/// Token opaco de acceso al catálogo web de UN cliente puntual.
/// No es una sesión de usuario: no lleva rol ni permisos de admin, no
/// habilita ningún otro endpoint y solo autoriza ver el catálogo con la
/// lista de precios de ese cliente y crear pedidos a su nombre.
/// Un cliente puede tener varios vigentes a la vez.
model ClientAccessToken {
  id              Int      @id @default(autoincrement())
  clientId        Int      @map("client_id")
  /// 128 bits de randomBytes codificados en base64url. Nunca un id
  /// secuencial ni un valor adivinable.
  token           String   @unique
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Quién lo generó. Es trazabilidad del usuario interno, no autorización.
  createdByUserId Int       @map("created_by_user_id")
  /// Se marca al revocar. La fila no se borra: un enlace cortado sigue en el historial.
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([expiresAt])
  @@map("client_access_tokens")
}

// --- Facturación electrónica (FEL) ---

enum EstadoFactura {
  pendiente_certificacion
  certificada
  error

  @@map("estado_factura")
}

/// Factura de un pedido. Una sola por pedido (`orderId` es único).
/// La certificación ante la SAT la hace un certificador autorizado
/// (Digifact, Infile, Megaprint, ...) que todavía no está elegido: ver
/// `modules/billing/providers/fel.provider.ts`.
model Invoice {
  id     Int @id @default(autoincrement())
  /// Una factura por pedido.
  orderId Int            @unique @map("order_id")
  serie  String
  /// Correlativo interno de la secuencia PostgreSQL invoice_numero_seq.
  /// No es el número fiscal: ese lo asigna el certificador.
  numero          Int       @unique @default(dbgenerated("nextval('invoice_numero_seq')"))
  /// UUID que devuelve la SAT al certificar. NULL hasta entonces.
  uuidFel         String?   @map("uuid_fel")
  fechaCertificacion DateTime? @map("fecha_certificacion") @db.Timestamptz(3)
  estado          EstadoFactura @default(pendiente_certificacion)
  total           Decimal      @db.Decimal(12, 2)
  xmlUrl          String?      @map("xml_url")
  pdfUrl          String?      @map("pdf_url")
  /// Motivo por el que la certificación falló, si falló.
  error           String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([estado])
  @@map("invoices")
}
