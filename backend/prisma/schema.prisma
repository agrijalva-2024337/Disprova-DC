generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Seguridad ---

model Role {
  id       Int    @id @default(autoincrement())
  nombre   String @unique
  permisos Json

  users User[]

  @@map("roles")
}

model User {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  roleId       Int      @map("role_id")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  role      Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  auditLogs AuditLog[]

  @@map("users")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  entidad      String
  entidadId    String   @map("entidad_id")
  accion       String
  datosAntes   Json?    @map("datos_antes")
  datosDespues Json?    @map("datos_despues")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entidad, entidadId])
  @@map("audit_log")
}

// --- Catálogo ---

model Category {
  id       Int     @id @default(autoincrement())
  nombre   String
  parentId Int?    @map("parent_id")
  orden    Int     @default(0)
  activo   Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  nombre      String
  descripcion String?
  categoryId  Int      @map("category_id")
  marca       String?
  unidadBase  String   @map("unidad_base")
  controlado  Boolean  @default(false)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  category Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  units    ProductUnit[]
  images   ProductImage[]

  @@map("products")
}

model ProductUnit {
  id           Int     @id @default(autoincrement())
  productId    Int     @map("product_id")
  nombre       String
  factor       Decimal @db.Decimal(12, 4)
  codigoBarras String? @unique @map("codigo_barras")
  precioBase   Decimal @map("precio_base") @db.Decimal(12, 2)

  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  priceListItems PriceListItem[]

  @@map("product_units")
}

model ProductImage {
  id          Int     @id @default(autoincrement())
  productId   Int     @map("product_id")
  url         String
  orden       Int     @default(0)
  esPrincipal Boolean @default(false) @map("es_principal")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("product_images")
}

model PriceList {
  id          Int     @id @default(autoincrement())
  nombre      String
  descripcion String?
  activo      Boolean @default(true)

  items PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id            Int      @id @default(autoincrement())
  priceListId   Int      @map("price_list_id")
  productUnitId Int      @map("product_unit_id")
  precio        Decimal  @db.Decimal(12, 2)
  vigenteDesde  DateTime @map("vigente_desde") @db.Date

  priceList   PriceList   @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Restrict)

  @@unique([priceListId, productUnitId, vigenteDesde])
  @@map("price_list_items")
}
